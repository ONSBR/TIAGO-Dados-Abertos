# Copie para .env na raiz do checkout. Nenhuma variavel e obrigatoria: o servidor sobe
# sem este arquivo. Variavel ja definida no ambiente vence a do arquivo.
# Referencia completa, com efeito de cada uma: README.md, secao Configuracao

# Servidor
#MCP_HOST=0.0.0.0
#MCP_PORT=8003
#MCP_STATELESS=true
#MCP_ENV_FILE=.env

# Contratos (so para apontar outro diretorio de contratos; o padrao sao os embutidos no pacote)
#MCP_CONTRACTS_DIR=./contracts

# Execucao de SQL
#MCP_QUERY_TIMEOUT_S=30
#MCP_DUCKDB_MEMORY_LIMIT=2GB
#MCP_MAX_PAGE_LIMIT=1000
#MCP_MAX_SQL_CHARS=65536
# Troque o contato antes de expor: e como a fonte identifica quem consulta.
#MCP_HTTP_UA=mcp-tiago-dados-abertos/1.0 (contato@exemplo.com)

# Limites de abuso (teto agregado do processo; limite por origem e do proxy)
#MCP_RATE_LIMIT_GLOBAL_MAX=600
#MCP_RATE_LIMIT_MAX_KEYS=20000

# Datas: o fuso DOS DADOS, nao do servidor
#MCP_DATA_TZ=America/Sao_Paulo

# Diagnostico
#MCP_CORR_HEADER=x-request-id
#MCP_COBERTURA_PROBE=1
